<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_menu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="菜单"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/text"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:singleLine="true"
                android:text="@string/header_title"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:text="@string/header_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/pill_status"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="● 待机"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="@string/settings"
            android:textColor="@color/ghost_text"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/seg_container"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_file"
            style="@style/Text.Tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/source_file" />

        <TextView
            android:id="@+id/tab_mic"
            style="@style/Text.Tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/source_mic" />

        <TextView
            android:id="@+id/tab_media"
            style="@style/Text.Tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/source_media" />

        <TextView
            android:id="@+id/tab_image_audio"
            style="@style/Text.Tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/source_image_audio" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/card_scope"
        android:clipToOutline="true"
        android:padding="1dp">

        <com.dsh.wavescope.ScopeView
            android:id="@+id/scope_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_hold"
            android:layout_width="50dp"
            android:layout_height="25dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_hold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/hold"
            android:textColor="@color/hold_text"
            android:textSize="8sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/seg_container"
        android:orientation="horizontal"
        android:padding="3dp"
>

        <TextView
            android:id="@+id/tab_xt"
            style="@style/Text.ModeTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/mode_xt" />

        <TextView
            android:id="@+id/tab_xy"
            style="@style/Text.ModeTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/mode_xy" />

        <TextView
            android:id="@+id/tab_fft"
            style="@style/Text.ModeTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/seg_item"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/mode_fft" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/waterfall_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_surface"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="流速" />

                <TextView
                    android:id="@+id/tv_waterfall_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="1.00×"
                    android:textColor="@color/cyan"
                    android:textSize="8sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_waterfall_speed"
                style="@style/MiniSeek"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:max="500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="黑场" />

                <TextView
                    android:id="@+id/tv_waterfall_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0%"
                    android:textColor="@color/cyan"
                    android:textSize="8sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_waterfall_black"
                style="@style/MiniSeek"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:max="90" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="白场" />

                <TextView
                    android:id="@+id/tv_waterfall_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="100%"
                    android:textColor="@color/cyan"
                    android:textSize="8sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_waterfall_white"
                style="@style/MiniSeek"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:max="90" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="2dp">

            <TextView
                style="@style/Text.MetricLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="视图" />

            <TextView
                android:id="@+id/btn_waterfall_view"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="全局"
                android:textColor="@color/cyan"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/file_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="未选择文件"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace"
                android:text="@string/file_time_placeholder"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_file_toggle"
                android:layout_width="54dp"
                android:layout_height="28dp"
                android:background="@drawable/btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans"
                android:gravity="center"
                android:text="播放"
                android:textColor="@color/ghost_text"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seek_file"
                style="@style/FileSeek"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:max="1000" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_analysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="8sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_surface"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/Text.MetricLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metric_rate" />

            <TextView
                android:id="@+id/tv_rate"
                style="@style/Text.MetricValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/Text.MetricLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metric_channels" />

            <TextView
                android:id="@+id/tv_channels"
                style="@style/Text.MetricValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/Text.MetricLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metric_peak" />

            <TextView
                android:id="@+id/tv_peak"
                style="@style/Text.MetricValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/Text.MetricLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metric_scale" />

            <TextView
                android:id="@+id/tv_scale"
                style="@style/Text.MetricValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2.00 ms" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="@string/action_import"
            android:textColor="@color/action_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_export"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="导出"
            android:textColor="@color/ghost_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/footer_raw"
            android:textColor="@color/cyan_dim"
            android:textSize="7sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@color/stroke_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:text="@string/footer_no_resample"
            android:textColor="@color/text_muted"
            android:textSize="7sp" />
    </LinearLayout>
</LinearLayout>
